# ============================================================
# Mental Fatigue Detector — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ----- Application -----
APP_NAME="Mental Fatigue Detector"
APP_ENV=development          # development | staging | production
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars

# ----- Backend -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----- JWT -----
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- Database (PostgreSQL) -----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mental_fatigue_db
POSTGRES_USER=mf_user
POSTGRES_PASSWORD=mf_secure_password_change_me
DATABASE_URL=postgresql://mf_user:mf_secure_password_change_me@postgres:5432/mental_fatigue_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ----- Redis -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_change_me
REDIS_DB=0
REDIS_URL=redis://:redis_password_change_me@redis:6379/0

# ----- ML -----
ML_MODEL_PATH=/app/ml/models/best_model.joblib
ML_SCALER_PATH=/app/ml/models/scaler.joblib
ML_FEATURE_NAMES_PATH=/app/ml/models/feature_names.json
ML_INFERENCE_THRESHOLD=0.5
SHAP_BACKGROUND_SAMPLES=100

# ----- Frontend -----
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_APP_NAME="Mental Fatigue Detector"
VITE_APP_VERSION=1.0.0

# ----- Email (SMTP) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME="Mental Fatigue Detector"
SMTP_FROM_EMAIL=noreply@mentalfatigue.app
EMAIL_ALERTS_ENABLED=false

# ----- Rate Limiting -----
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/app/logs/backend.log

# ----- Notifications -----
FATIGUE_ALERT_THRESHOLD=0.7
HIGH_RISK_ALERT_THRESHOLD=0.85

# ----- Tracker -----
TRACKER_SEND_INTERVAL_SECONDS=1
TRACKER_API_URL=http://localhost:8000/api/v1
TRACKER_WS_URL=ws://localhost:8000/ws
