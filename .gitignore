# =============================================================
# MindGuard — .gitignore
# =============================================================

# ── Environment ────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Databases (local development only) ─────────────────────
*.db
*.sqlite3

# ── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.venv/
venv/
env/

# ── Node ───────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-lock.yaml

# ── Build Artifacts ────────────────────────────────────────
dist/
build/
*.egg

# ── IDE & Editor ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Logs ───────────────────────────────────────────────────
logs/
*.log

# ── Python Testing & Typing ────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# ── Databases (local development only) ─────────────────────
*.db
*.sqlite3

# ── Generated Dataset (regenerate via dataset/generator.py) ─
dataset/generated/

# ── Docker ─────────────────────────────────────────────────
docker-compose.override.yml

# ── Compiled / Binary ──────────────────────────────────────
*.pyc
*.pyo